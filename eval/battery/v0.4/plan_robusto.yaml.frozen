# Bateria congelada del plan derivado con dependencias invalidas.
# Ficha v0.4/0011. La tanda v0.4.1 la integra quitando el sufijo .frozen;
# hasta entonces no entra en el digest.

- id: plan_robusto_ciclo_y_luego_valido
  track: conformance
  description: "Core ficha v0.4/0011: un plan derivado ciclico se renegocia y el segundo plan valido se usa."
  capability: task.run
  fixture: eval/fixtures/orchestration_effort.yaml
  input:
    prompt: "resuelve dos partes"
    identity: { user_id: u1, service: local_cli }
  world:
    script:
      derivations:
        - requirements: [{ id: r1, text: "resolver" }]
          subtasks:
            - { prompt: "primera", domain: general, depends_on: [1], covers: [r1] }
            - { prompt: "segunda", domain: general, depends_on: [0], covers: [r1] }
        - requirements: [{ id: r1, text: "resolver" }]
          subtasks:
            - { prompt: "primera", domain: general, covers: [r1] }
            - { prompt: "segunda", domain: general, depends_on: [0], covers: [r1] }
      responses:
        fake_general: ["PRIMERA", "SEGUNDA"]
        fake_combiner: ["COMBINADO_FINAL"]
      evaluate_decisions: [done]
  expect:
    stop_reason: task_done
    response: "COMBINADO_FINAL"
    plan_attempts: 2
    degradations: []

- id: plan_robusto_dos_ciclos_degradan_task_run
  track: conformance
  description: "Core ficha v0.4/0011: dos planes derivados ciclicos repliegan task.run al prompt integro."
  capability: task.run
  fixture: eval/fixtures/orchestration_effort.yaml
  input:
    prompt: "resuelve dos partes"
    identity: { user_id: u1, service: local_cli }
  world:
    script:
      derivations:
        - requirements: [{ id: r1, text: "resolver" }]
          subtasks:
            - { prompt: "primera", domain: general, depends_on: [1], covers: [r1] }
            - { prompt: "segunda", domain: general, depends_on: [0], covers: [r1] }
        - requirements: [{ id: r1, text: "resolver" }]
          subtasks:
            - { prompt: "primera", domain: general, depends_on: [1], covers: [r1] }
            - { prompt: "segunda", domain: general, depends_on: [0], covers: [r1] }
      responses:
        fake_general: ["RESPUESTA_INTEGRA"]
        fake_combiner: ["COMBINADO_FINAL"]
      evaluate_decisions: [done]
  expect:
    stop_reason: task_done
    response: "COMBINADO_FINAL"
    plan_attempts: 2
    plan_ready:
      plan:
        - { index: 0, prompt: "resuelve dos partes", domain: general, depends_on: [] }
    degradations:
      - { stage: plan, reason: invalid_dependencies, action: single_subtask }
      - { stage: plan, reason: requirements_unavailable, action: skip_coverage_check }

- id: plan_robusto_dos_ciclos_degradan_task_plan
  track: conformance
  description: "Core ficha v0.4/0011: task.plan publica el repliegue tras dos planes derivados ciclicos."
  capability: task.plan
  fixture: eval/fixtures/orchestration_effort.yaml
  input:
    prompt: "resuelve dos partes"
    identity: { user_id: u1, service: local_cli }
  world:
    script:
      derivations:
        - requirements: [{ id: r1, text: "resolver" }]
          subtasks:
            - { prompt: "primera", domain: general, depends_on: [1], covers: [r1] }
            - { prompt: "segunda", domain: general, depends_on: [0], covers: [r1] }
        - requirements: [{ id: r1, text: "resolver" }]
          subtasks:
            - { prompt: "primera", domain: general, depends_on: [1], covers: [r1] }
            - { prompt: "segunda", domain: general, depends_on: [0], covers: [r1] }
  expect:
    plan:
      - { index: 0, prompt: "resuelve dos partes", domain: general, depends_on: [] }
    degradations:
      - { stage: plan, reason: invalid_dependencies, action: single_subtask }
      - { stage: plan, reason: requirements_unavailable, action: skip_coverage_check }

- id: plan_robusto_ciclo_suministrado_sigue_siendo_error
  track: conformance
  description: "Core ficha v0.4/0011: un ciclo suministrado sigue siendo PlanDependencyError."
  capability: task.run
  fixture: eval/fixtures/orchestration_effort.yaml
  input:
    prompt: "tarea ciclica"
    plan:
      - { index: 0, prompt: "primera", domain: general, depends_on: [1] }
      - { index: 1, prompt: "segunda", domain: general, depends_on: [0] }
    requirements:
      - { id: r1, statement: "resolver", covered_by: [0, 1] }
    identity: { user_id: u1, service: local_cli }
  expect:
    error_type: PlanDependencyError
    error_field: depends_on
